NODE_ENV=development
PORT=3020
DATABASE_URL=postgres://storix:storix@localhost:5440/storix
APP_ORIGIN=http://localhost:5180
BETTER_AUTH_SECRET=
PASSKEY_RP_ID=localhost
LOG_LEVEL=debug
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=storix-media
S3_ACCESS_KEY_ID=storix
S3_SECRET_ACCESS_KEY=storix-dev-secret
S3_FORCE_PATH_STYLE=true
# generate with: openssl rand -base64 32
MEDIA_URL_SECRET=
# optional, push stays off when unset; generate with: pnpm --filter @storix/worker exec web-push generate-vapid-keys --json > <private file>
# uncomment all three together (an empty value fails env validation)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://storix.tristanhourtoulle.fr

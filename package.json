{
  "name": "storix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @storix/shared test",
    "db:generate": "pnpm --filter @storix/db db:generate",
    "db:migrate": "pnpm --filter @storix/db db:migrate",
    "dev:db": "docker compose up -d postgres minio minio-init",
    "build:api": "pnpm --filter @storix/web build && pnpm --filter @storix/api build",
    "build:worker": "pnpm --filter @storix/worker build",
    "build": "pnpm build:api && pnpm build:worker",
    "start": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/main.js",
    "migrate:prod": "node apps/api/dist/migrate.js",
    "preview:prod": "pnpm build && node --env-file=.env.preview apps/api/dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
